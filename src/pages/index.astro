---
import Tab from "../components/Tab.astro";
import TabBar from "../components/TabBar.astro";
import AppShell from "../components/AppShell.astro";
import Terminal from "../components/Terminal.astro";
import TerminalPanel from "../components/TerminalPanel.astro";
import TerminalSession from "../components/TerminalSession.astro";
import Base from "../layouts/Base.astro";
---

<Base title="NafisApp - Home">
	<AppShell>
		<h1 class="sr-only">Welcome</h1>
		<Terminal>
			<TabBar slot="tabs">
				<Tab active>Terminal</Tab>
				<Tab>Projects</Tab>
				<Tab>CV</Tab>
				<Tab>Contact</Tab>
			</TabBar>
			<TerminalPanel id="panel-1" labelledby="tab-1">
				<TerminalSession />
			</TerminalPanel>
			<div slot="actions">
				quick actions
			</div>
			<div slot="input">
				input bar
			</div>
		</Terminal>
	</AppShell>
</Base>
