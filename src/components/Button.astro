---
import "../styles/tokens.css";

const { variant = "primary", href } = Astro.props;
const BtnElement = href ? "a" : "button";
---

<BtnElement href={href} class={`btn ${variant}`}><slot /></BtnElement>

<style>
    .btn {
        display: inline-block;
        text-decoration: none;

        font-family: var(--font-display);
        font-size: var(--text-md);
        font-weight: 700;

        line-height: 1.2;

        color: var(--color-ink);
        cursor: pointer;

        border: var(--border-width) solid var(--color-ink);
        border-radius: var(--radius);

        padding: var(--space-3) var(--space-5);
        transition: translate var(--speed), box-shadow var(--speed);
        box-shadow: var(--shadow-offset-sm) var(--shadow-offset-sm) 0 var(--color-ink);
    }

    /* Lift: move up-left by --lift, and grow the shadow by the same amount so the shadow corner stays where it was. */
    .btn:hover {
        translate: calc(var(--lift) * -1) calc(var(--lift) * -1);
        box-shadow:
            calc(var(--shadow-offset-sm) + var(--lift))
            calc(var(--shadow-offset-sm) + var(--lift))
            0 var(--color-ink);
    }

    /* Press: sink into the spot where the shadow was, and drop the shadow. */
    .btn:active {
        translate: var(--shadow-offset-sm) var(--shadow-offset-sm);
        box-shadow: 0 0 0 var(--color-ink);
    }

    .btn:focus-visible {
        outline: var(--border-width) solid var(--color-ink);
        outline-offset: var(--space-2);
    }

    .primary {
        background: var(--color-accent);
    }

    .secondary {
        background: var(--color-secondary);
    }

    @media (prefers-reduced-motion: reduce) {
        .btn {
            transition: none;
        }
    }
</style>
