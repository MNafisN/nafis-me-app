---
// Maximize toggle: lets the terminal fill the browser window on wide screens
---

<button type="button" class="maximize" aria-keyshortcuts="f">
    <kbd>F</kbd> <span class="maximize-label">maximize</span>
</button>

<style>
    /* A utility button: same shape as the quick-action chips, but a muted outline that turns solid on hover */
    .maximize {
        background: transparent;
        color: var(--term-muted);
        cursor: pointer;

        font: inherit;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        line-height: 1.2;
        white-space: nowrap;

        border: var(--border-width) solid var(--term-muted);
        border-radius: var(--radius);

        padding: var(--space-2) var(--space-3);
        min-height: 2rem;
        transition: color var(--speed), border-color var(--speed), background-color var(--speed);
    }

    .maximize kbd {
        color: inherit;
        border-color: currentColor;
        background: transparent;
    }

    /* F only works from a tab or button, so on Terminal tabs (where the input has focus) the button shows no key */
    :global(.terminal:not([data-view="page"])) .maximize kbd {
        display: none;
    }

    @media (hover: hover) {
        .maximize:hover {
            color: var(--color-ink);
            border-color: var(--color-ink);
            background: var(--color-bg);
        }
    }

    .maximize:focus-visible {
        outline: var(--border-width) solid transparent;
        color: var(--color-ink);
        border-color: var(--color-ink);
        box-shadow: inset 0 0 0 var(--border-width) var(--color-ink);
    }

    /* Phone-sized screens already use the full window */
    @media (width < 48rem) {
        .maximize {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .maximize {
            transition: none;
        }
    }
</style>

<script>
    const root = document.documentElement;
    const button = document.querySelector(".maximize");
    const label = button.querySelector(".maximize-label");

    function render() {
        label.textContent = root.hasAttribute("data-maximized") ? "restore" : "maximize";
    }

    function toggle() {
        const maximized = root.toggleAttribute("data-maximized");
        try {
            localStorage.setItem("terminal-maximized", maximized ? "1" : "0");
        } catch {}
        render();
    }

    button.addEventListener("click", toggle);

    document.addEventListener("keydown", (event) => {
        if (event.key.toLowerCase() !== "f" || event.ctrlKey || event.metaKey || event.altKey) return;
        // activeElement, not event.target: the input bar may have just taken focus for this key
        if (document.activeElement.closest("input, textarea, select, [contenteditable]")) return;
        if (!matchMedia("(width >= 48rem)").matches) return;

        event.preventDefault();
        toggle();
    });

    render();
</script>
