---
// Maximize toggle: lets the terminal fill the browser window on wide screens
---

<button type="button" class="maximize bar-button" aria-keyshortcuts="f">
    <kbd>F</kbd> <span class="maximize-label">maximize</span>
</button>

<style>
    /* The slanted bar-button look comes from global.css */

    /* F only works from a tab or button, so on Terminal tabs (where the input has focus) the button shows no key */
    :global(.terminal:not([data-view="page"])) .maximize kbd {
        display: none;
    }

    /* Phone-sized screens already use the full window */
    @media (width < 48rem) {
        .maximize {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .maximize {
            transition: none;
        }
    }
</style>

<script>
    const root = document.documentElement;
    const button = document.querySelector(".maximize");
    const label = button.querySelector(".maximize-label");

    function render() {
        label.textContent = root.hasAttribute("data-maximized") ? "restore" : "maximize";
    }

    function toggle() {
        const maximized = root.toggleAttribute("data-maximized");
        try {
            localStorage.setItem("terminal-maximized", maximized ? "1" : "0");
        } catch {}
        render();
    }

    button.addEventListener("click", toggle);

    document.addEventListener("keydown", (event) => {
        if (event.key.toLowerCase() !== "f" || event.ctrlKey || event.metaKey || event.altKey) return;
        // activeElement, not event.target: the input bar may have just taken focus for this key
        if (document.activeElement.closest("input, textarea, select, [contenteditable]")) return;
        if (!matchMedia("(width >= 48rem)").matches) return;

        event.preventDefault();
        toggle();
    });

    render();
</script>
