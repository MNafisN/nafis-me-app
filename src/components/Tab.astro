---
const { active = false, id, controls, closable = false } = Astro.props;
---

<div class:list={["tab-item", { closable }]}>
    <button type="button" role="tab" id={id} aria-controls={controls} aria-selected={active ? "true" : "false"} class:list={["tab", { active }]} title={closable ? "Double-click, press F2 or long-press to rename" : undefined}>
        <slot />
    </button>
    {closable && (
        <>
            <input type="text" class="tab-rename" maxlength="16" size="16" aria-label="Tab name" hidden />
            <button type="button" class="tab-close" tabindex="-1" aria-label="Close tab">×</button>
        </>
    )}
</div>

<style>
    .tab-item {
        position: relative;
        display: flex;
        flex-shrink: 0;
    }

    .tab {
        background: var(--color-bg);
        color: var(--color-ink);
        cursor: pointer;

        font: inherit;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 700;

        line-height: 1.2;
        white-space: nowrap;

        /* A long press renames on touch screens, so it must not select text or open the copy menu */
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;

        border: var(--border-width) solid var(--color-ink);
        border-bottom: 0;
        border-radius: var(--radius-tab);

        /* The tab bar's bottom line, drawn inside the tab so it survives the scrolling tab list */
        box-shadow: inset 0 calc(var(--border-width) * -1) 0 var(--color-ink);

        padding: var(--space-2) var(--space-4);
        min-height: 2.75rem;
        transition: background-color var(--speed);
    }

    .closable .tab {
        padding-right: 2.25rem;
    }

    /* Only devices with a real mouse get hover colors; touch screens would leave them stuck after a tap */
    @media (hover: hover) {
        .tab-item:hover .tab:not(.active) {
            background: var(--color-accent);
        }
    }

    .tab.active {
        background: var(--color-surface);
        box-shadow: none;
    }

    /* Held long enough: lifting the finger now opens rename. Inverted, so it can't be mistaken for hover. */
    .tab.is-armed {
        background: var(--color-ink);
        color: var(--color-surface);
    }

    .tab.is-armed ~ .tab-close {
        color: var(--color-surface);
    }

    .tab:focus-visible,
    .tab-rename:focus-visible {
        outline: var(--border-width) solid transparent;
        box-shadow:
            inset var(--border-width) 0 0 var(--color-ink),
            inset calc(var(--border-width) * -1) 0 0 var(--color-ink),
            inset 0 var(--border-width) 0 var(--color-ink);
    }

    .tab-rename {
        background: var(--color-surface);
        color: var(--color-ink);

        font: inherit;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 700;

        line-height: 1.2;

        border: var(--border-width) solid var(--color-ink);
        border-bottom: 0;
        border-radius: var(--radius-tab);

        padding: var(--space-2) 2.25rem var(--space-2) var(--space-4);
        min-height: 2.75rem;
        min-width: 8ch;
        field-sizing: content;
    }

    .tab-close {
        position: absolute;
        top: 50%;
        right: var(--space-3);
        translate: 0 -50%;

        display: grid;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        padding: 0;

        background: transparent;
        color: var(--color-ink);
        cursor: pointer;

        font: inherit;
        font-size: var(--text-md);
        line-height: 1;

        border: 0;
        border-radius: var(--radius);
    }

    .tab-close:hover {
        background: var(--color-ink);
        color: var(--color-surface);
    }

    /* iOS zooms into text boxes under 16px, so the rename box gets 16px on touch screens */
    @media (pointer: coarse) {
        .tab-rename {
            font-size: var(--text-md);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tab {
            transition: none;
        }
    }
</style>
