---
// Terminal app organism: tabs, panels, input and bottom bar, plus the script that runs them
import CommandMenu from "./CommandMenu.astro";
import InputBar from "./InputBar.astro";
import MaximizeToggle from "./MaximizeToggle.astro";
import MessageTemplates from "./MessageTemplates.astro";
import ShortcutsHint from "./ShortcutsHint.astro";
import Tab from "./Tab.astro";
import TabBar from "./TabBar.astro";
import Terminal from "./Terminal.astro";
import TerminalPanel from "./TerminalPanel.astro";
import TerminalSession from "./TerminalSession.astro";
---

<Terminal>
    <TabBar slot="tabs">
        <Tab id="tab-home" controls="panel-home">Home</Tab>
        <Tab id="tab-projects" controls="panel-projects">Projects</Tab>
        <Tab id="tab-cv" controls="panel-cv">CV</Tab>
        <Tab active id="tab-1" controls="panel-1">Terminal</Tab>
    </TabBar>
    <TerminalPanel id="panel-home" labelledby="tab-home" hidden>
        <p>Coming soon.</p>
    </TerminalPanel>
    <TerminalPanel id="panel-projects" labelledby="tab-projects" hidden>
        <p>Coming soon.</p>
    </TerminalPanel>
    <TerminalPanel id="panel-cv" labelledby="tab-cv" hidden>
        <p>Coming soon.</p>
    </TerminalPanel>
    <TerminalPanel id="panel-1" labelledby="tab-1">
        <TerminalSession />
    </TerminalPanel>
    <div slot="input">
        <CommandMenu />
        <InputBar />
    </div>
    <div slot="actions" class="actions">
        <div class="quick-actions" role="group" aria-label="Quick actions">
            <button type="button" class="quick" data-command="/help">/help</button>
            <button type="button" class="quick" data-command="/projects">/projects</button>
            <button type="button" class="quick" data-fill="/project ">/project …</button>
            <button type="button" class="quick" data-command="/cv">/cv</button>
            <button type="button" class="quick" data-command="/contact">/contact</button>
        </div>
        <div class="status">
            <ShortcutsHint />
            <MaximizeToggle />
        </div>
    </div>
</Terminal>

<MessageTemplates />

<template id="tab-template">
    <Tab closable>Terminal</Tab>
</template>

<template id="panel-template">
    <TerminalPanel hidden>
        <TerminalSession />
    </TerminalPanel>
</template>

<style>
    .actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-left: var(--space-3);
    }

    /* On phones the status buttons are hidden, so the chips get the whole row and scroll sideways */
    .quick-actions {
        display: flex;
        gap: var(--space-2);
        min-width: 0;
        overflow-x: auto;
        scrollbar-width: none;
        padding-block: var(--space-2);
    }

    .quick-actions::-webkit-scrollbar {
        display: none;
    }

    .quick {
        flex-shrink: 0;
        background: var(--color-bg);
        color: var(--color-ink);
        cursor: pointer;

        font: inherit;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        line-height: 1.2;
        white-space: nowrap;

        border: var(--border-width) solid var(--color-ink);
        border-radius: var(--radius);

        padding: var(--space-2) var(--space-3);
        min-height: 2rem;
        transition: background-color var(--speed);
    }

    @media (hover: hover) {
        .quick:not([aria-disabled="true"]):hover {
            background: var(--color-accent);
        }
    }

    /* While a reply is on its way; aria-disabled rather than disabled, so a pressed chip keeps keyboard focus */
    .quick[aria-disabled="true"] {
        color: var(--term-muted);
        border-color: var(--term-muted);
        cursor: progress;
    }

    .quick:focus-visible {
        outline: var(--border-width) solid transparent;
        box-shadow: inset 0 0 0 var(--border-width) var(--color-ink);
    }

    .status {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .quick {
            transition: none;
        }
    }
</style>

<script>
    import { askAgent, isCommand, runCommand } from "../scripts/commands.js";
    import { renderBlocks, renderCommand, renderPending } from "../scripts/render.js";

    const tablist = document.querySelector('[role="tablist"]');
    const newTabButton = document.querySelector(".tab-new");
    const output = document.getElementById("panel-1").parentElement;
    const tabTemplate = document.getElementById("tab-template");
    const panelTemplate = document.getElementById("panel-template");

    const MAX_TERMINALS = 6;
    let lastTerminalTab = document.getElementById("tab-1");

    function panelOf(tab) {
        return document.getElementById(tab.getAttribute("aria-controls"));
    }

    function isTerminal(tab) {
        return Boolean(panelOf(tab)?.querySelector("[data-log]"));
    }

    function activate(tab) {
        for (const t of tablist.querySelectorAll('[role="tab"]')) {
            const selected = t === tab;
            t.setAttribute("aria-selected", String(selected));
            t.classList.toggle("active", selected);
            t.tabIndex = selected ? 0 : -1;
            const panel = panelOf(t);
            if (panel) panel.hidden = !selected;
        }
        if (isTerminal(tab)) lastTerminalTab = tab;
        tab.scrollIntoView({ block: "nearest", inline: "nearest" });
    }

    function setLabel(tab, name) {
        tab.textContent = name;
        tab.parentElement.querySelector(".tab-close").setAttribute("aria-label", `Close ${name}`);
    }

    function updateNewTabButton() {
        const terminals = 1 + tablist.querySelectorAll(".tab-close").length;
        newTabButton.disabled = terminals >= MAX_TERMINALS;
    }

    function createTerminalTab() {
        let number = 2;
        while (document.getElementById(`tab-${number}`)) number += 1;

        const item = tabTemplate.content.firstElementChild.cloneNode(true);
        const tab = item.querySelector('[role="tab"]');
        const panel = panelTemplate.content.firstElementChild.cloneNode(true);

        tab.id = `tab-${number}`;
        panel.id = `panel-${number}`;
        tab.setAttribute("aria-controls", panel.id);
        panel.setAttribute("aria-labelledby", tab.id);
        setLabel(tab, `Terminal ${number}`);

        tablist.append(item);
        output.append(panel);
        activate(tab);
        updateNewTabButton();
        document.dispatchEvent(new CustomEvent("terminal:focus"));
    }

    function closeTab(tab) {
        if (!tab.parentElement.classList.contains("closable")) return;

        const tabs = [...tablist.querySelectorAll('[role="tab"]')];
        const index = tabs.indexOf(tab);
        const wasSelected = tab.getAttribute("aria-selected") === "true";

        document.getElementById(tab.getAttribute("aria-controls")).remove();
        tab.parentElement.remove();

        const current = wasSelected
            ? (tabs[index + 1] ?? tabs[index - 1])
            : tablist.querySelector('[aria-selected="true"]');
        activate(current);
        current.focus();
        updateNewTabButton();
    }

    function startRename(tab) {
        const input = tab.parentElement.querySelector(".tab-rename");
        if (!input) return;

        input.value = tab.textContent.trim();
        tab.hidden = true;
        input.hidden = false;
        input.focus();
        input.select();
    }

    function finishRename(input, save, refocus) {
        if (input.hidden) return;

        const tab = input.parentElement.querySelector('[role="tab"]');
        const name = input.value.trim();
        if (save && name) setLabel(tab, name);

        input.hidden = true;
        tab.hidden = false;
        if (refocus) tab.focus();
    }

    tablist.addEventListener("click", (event) => {
        const close = event.target.closest(".tab-close");
        if (close) {
            closeTab(close.parentElement.querySelector('[role="tab"]'));
            return;
        }

        const tab = event.target.closest('[role="tab"]');
        if (!tab) return;
        activate(tab);
        // A pointer click on a Terminal tab is ready for typing; keyboard clicks (detail 0) keep focus on the tab
        if (event.detail > 0 && isTerminal(tab)) document.dispatchEvent(new CustomEvent("terminal:focus"));
    });

    tablist.addEventListener("dblclick", (event) => {
        const tab = event.target.closest('[role="tab"]');
        if (tab) startRename(tab);
    });

    // Long press to rename on touch screens. Rename opens when the finger lifts,
    // because iOS only shows the keyboard for a focus that happens inside a touch event.
    const LONG_PRESS_MS = 500;
    let press = null;

    function cancelPress() {
        if (!press) return;
        clearTimeout(press.timer);
        press.tab.classList.remove("is-armed");
        press = null;
    }

    tablist.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse") return;
        const tab = event.target.closest('[role="tab"]');
        if (!tab || !tab.parentElement.classList.contains("closable")) return;

        cancelPress();
        press = { tab, x: event.clientX, y: event.clientY, armed: false };
        press.timer = setTimeout(() => {
            press.armed = true;
            tab.classList.add("is-armed");
            navigator.vibrate?.(15);
        }, LONG_PRESS_MS);
    });

    tablist.addEventListener("pointermove", (event) => {
        if (press && Math.hypot(event.clientX - press.x, event.clientY - press.y) > 10) cancelPress();
    });

    tablist.addEventListener("pointerup", () => {
        if (!press) return;
        const { tab, armed } = press;
        cancelPress();
        if (armed) startRename(tab);
    });

    tablist.addEventListener("pointercancel", cancelPress);

    // Android opens a menu on long press; block it only during a touch press, so desktop right-click still works
    tablist.addEventListener("contextmenu", (event) => {
        if (press) event.preventDefault();
    });

    tablist.addEventListener("focusout", (event) => {
        if (event.target.matches(".tab-rename")) finishRename(event.target, true, false);
    });

    tablist.addEventListener("keydown", (event) => {
        if (event.target.matches(".tab-rename")) {
            if (event.key === "Enter") finishRename(event.target, true, true);
            else if (event.key === "Escape") finishRename(event.target, false, true);
            return;
        }

        const tabs = [...tablist.querySelectorAll('[role="tab"]')];
        const index = tabs.indexOf(document.activeElement);
        if (index === -1) return;

        if (event.key === "F2") {
            event.preventDefault();
            startRename(tabs[index]);
            return;
        }

        if (event.key === "Delete") {
            closeTab(tabs[index]);
            return;
        }

        let next;
        if (event.key === "ArrowRight") next = tabs[(index + 1) % tabs.length];
        else if (event.key === "ArrowLeft") next = tabs[(index - 1 + tabs.length) % tabs.length];
        else if (event.key === "Home") next = tabs[0];
        else if (event.key === "End") next = tabs[tabs.length - 1];
        else return;

        event.preventDefault();
        activate(next);
        next.focus();
    });

    newTabButton.addEventListener("click", createTerminalTab);

    // Messages: a /command runs in the browser, anything else goes to the agent.
    // Sending from Home, Projects or CV switches to the last-used Terminal tab first.
    let busy = false;
    // The fill chip (/project …) stays usable: filling the input is fine while a reply is pending
    const commandChips = document.querySelectorAll(".quick[data-command]");

    function setBusy(value) {
        busy = value;
        for (const chip of commandChips) {
            if (busy) chip.setAttribute("aria-disabled", "true");
            else chip.removeAttribute("aria-disabled");
        }
        document.dispatchEvent(new CustomEvent("terminal:busy", { detail: { busy } }));
    }

    function scrollToBottom(panel) {
        panel.scrollTop = panel.scrollHeight;
    }

    function maximize() {
        if (!matchMedia("(width >= 48rem)").matches) return false;
        document.querySelector(".maximize")?.click();
        return true;
    }

    async function send(text) {
        if (busy || !text.trim()) return;

        let tab = tablist.querySelector('[aria-selected="true"]');
        if (!isTerminal(tab)) {
            tab = lastTerminalTab?.isConnected ? lastTerminalTab : document.getElementById("tab-1");
            activate(tab);
        }
        const panel = panelOf(tab);
        const log = panel.querySelector("[data-log]");

        log.append(renderCommand(text));
        scrollToBottom(panel);
        setBusy(true);

        let blocks;
        try {
            if (isCommand(text)) {
                blocks = await runCommand(text, { clear: () => log.replaceChildren(), maximize });
            } else {
                const pending = renderPending();
                log.append(pending);
                scrollToBottom(panel);
                try {
                    blocks = await askAgent(text);
                } finally {
                    pending.remove();
                }
            }
        } catch {
            blocks = [{ type: "error", text: "Something went wrong. Please try again." }];
        }

        try {
            log.append(renderBlocks(blocks));
        } finally {
            scrollToBottom(panel);
            setBusy(false);
        }
    }

    document.addEventListener("terminal:submit", (event) => send(event.detail.text));

    document.querySelector(".quick-actions").addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (!button) return;

        if (button.dataset.fill) {
            document.dispatchEvent(new CustomEvent("terminal:fill", { detail: { text: button.dataset.fill } }));
        } else {
            send(button.dataset.command);
        }
    });

    activate(tablist.querySelector('[aria-selected="true"]'));
</script>
