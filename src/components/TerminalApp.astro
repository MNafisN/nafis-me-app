---
import Tab from "./Tab.astro";
import TabBar from "./TabBar.astro";
import Terminal from "./Terminal.astro";
import TerminalPanel from "./TerminalPanel.astro";
import TerminalSession from "./TerminalSession.astro";
---

<Terminal>
    <TabBar slot="tabs">
        <Tab active>Terminal</Tab>
        <Tab>Projects</Tab>
        <Tab>CV</Tab>
        <Tab>Contact</Tab>
    </TabBar>
    <TerminalPanel id="panel-1" labelledby="tab-1">
        <TerminalSession />
    </TerminalPanel>
    <div slot="actions">
        quick actions
    </div>
    <div slot="input">
        input bar
    </div>
</Terminal>

<template id="tab-template">
    <Tab>Terminal</Tab>
</template>

<template id="panel-template">
    <TerminalPanel hidden>
        <TerminalSession />
    </TerminalPanel>
</template>
