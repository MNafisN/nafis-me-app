---
// page: a plain web page (Home, Projects, CV) instead of a terminal session
const { id, labelledby, hidden = false, page = false } = Astro.props;
---

<section role="tabpanel" class="panel" id={id} aria-labelledby={labelledby} hidden={hidden} tabindex="0">
    <div class:list={["panel-content", { page }]}><slot /></div>
</section>

<style>
    /* Positioned, so absolute children (the sr-only link labels) are clipped here instead of stretching the page */
    .panel {
        position: relative;
        height: 100%;
        overflow-y: auto;
        padding: var(--space-4);
    }

    /* A ceiling on line length; only matters when the terminal is maximized on a wide screen */
    .panel-content {
        max-width: 200ch;
    }

    /* Pages read like a normal website: a centered column, text still left-aligned inside it */
    .panel-content.page {
        max-width: var(--container);
        margin-inline: auto;
    }

    .panel:focus-visible {
        outline: var(--border-width) solid var(--color-ink);
        outline-offset: calc(var(--border-width) * -2);
    }

    .panel[hidden] {
        display: none;
    }
</style>
