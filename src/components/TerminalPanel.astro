---
const { id, labelledby, hidden = false } = Astro.props;
---

<section role="tabpanel" class="panel" id={id} aria-labelledby={labelledby} hidden={hidden}>
    <slot />
</section>

<style>
    .panel {
        height: 100%;
        overflow-y: auto;
        padding: var(--space-4);
    }

    .panel[hidden] {
        display: none;
    }
</style>
