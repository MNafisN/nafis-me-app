---
const { id, labelledby, hidden = false } = Astro.props;
---

<section role="tabpanel" class="panel" id={id} aria-labelledby={labelledby} hidden={hidden} tabindex="0">
    <div class="panel-content"><slot /></div>
</section>

<style>
    .panel {
        height: 100%;
        overflow-y: auto;
        padding: var(--space-4);
    }

    /* A ceiling on line length; only matters when the terminal is maximized on a wide screen */
    .panel-content {
        max-width: 200ch;
    }

    .panel:focus-visible {
        outline: var(--border-width) solid var(--color-ink);
        outline-offset: calc(var(--border-width) * -2);
    }

    .panel[hidden] {
        display: none;
    }
</style>
