---
// Terminal session: the starting state of every Terminal tab, plus its message log
import { getProfile } from "../data/profile.js";

const { lang = "id" } = Astro.props;
const { ui } = getProfile(lang);
---

<p class="banner">{ui.banner}</p>
<p class="credit">© 2026 NafisApp</p>
<div class="log" role="log" aria-live="polite" data-log></div>

<style>
    .banner {
        color: var(--term-muted);
    }

    .credit {
        color: var(--term-muted);
        font-size: var(--text-sm);
    }
</style>
