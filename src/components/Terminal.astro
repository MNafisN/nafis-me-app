---
// Terminal page frame (big card)
---

<section class="terminal">
    <div class="terminal-tabs"><slot name="tabs" /></div>
    <div class="terminal-output"><slot /></div>
    <div class="terminal-input"><slot name="input" /></div>
    <div class="terminal-actions"><slot name="actions" /></div>
</section>

<style>
    .terminal {
        background: var(--color-surface);

        border: var(--border-width) solid var(--color-ink);
        border-radius: 0;

        box-shadow: none;

        display: grid;
        grid-template-rows: auto 1fr auto auto;
        grid-template-columns: minmax(0, 1fr);       /* a wide tab bar can't stretch the card */

        width: min(100%, var(--terminal-width));
        height: 100dvh;                             /* on mobile views */
    }

    .terminal-output {
        overflow: hidden;
        min-height: 0;
    }

    /* The input sits on top of the bottom bar, so the line separates it from the output */
    .terminal-input {
        position: relative;
        border-top: var(--border-width) solid var(--color-ink);
    }

    /* Home, Projects and CV are plain pages: no input row, and the bottom bar keeps only the maximize button */
    .terminal[data-view="page"] .terminal-input {
        display: none;
    }

    @media (min-width: 48rem) {
        .terminal[data-view="page"] .terminal-actions {
            border-top: var(--border-width) solid var(--color-ink);
        }

        .terminal {
            height: min(100dvh - 4rem, 46rem);
            border-radius: var(--radius);
            box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--color-ink);
        }
    }

    /* Maximized: fill the browser window, the same way the phone layout does */
    :global(html[data-maximized]) .terminal {
        width: 100%;
        height: 100dvh;
        border-radius: 0;
        box-shadow: none;
    }
</style>
